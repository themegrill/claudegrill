#!/bin/sh
#
# Refuse a commit that carries licence material.
#
# Install into a repo that holds a licence key:
#
#   node <themegrill-qa>/plugins/themegrill-qa/scripts/install-git-hook.mjs
#
# or by hand:
#
#   ln -s <themegrill-qa>/plugins/themegrill-qa/hooks/pre-commit-secrets \
#         .git/hooks/pre-commit
#
# This is the half of the guard that can see the developer's ACTUAL key, because
# it runs where `.env.local` lives — so it catches the mistake people really
# make, which is pasting a working key into a spec to debug something and then
# committing it with everything else.
#
# It is also the half that `git commit --no-verify` skips, and the half that
# does not exist on a machine where nobody ran the installer. The CI job
# (.github/workflows/secret-scan.yml) is the backstop for both.

set -e

# Resolve themegrill-qa: the environment wins, then a sibling checkout.
QA_HOME="${THEMEGRILL_QA_HOME:-}"
if [ -z "$QA_HOME" ]; then
  for candidate in "$(git rev-parse --show-toplevel)/../themegrill-qa" \
                   "$HOME/Work/Projects/themegrill-qa"; do
    if [ -d "$candidate/plugins/themegrill-qa/scripts" ]; then
      QA_HOME="$candidate"
      break
    fi
  done
fi

if [ -z "$QA_HOME" ] || [ ! -f "$QA_HOME/plugins/themegrill-qa/scripts/scan-secrets.mjs" ]; then
  # A missing scanner must NOT silently allow the commit. Say so loudly and
  # stop: "the guard is not installed" and "the guard passed" have to look
  # different, or the guard is decorative.
  echo "pre-commit: cannot find themegrill-qa's scan-secrets.mjs." >&2
  echo "            Set THEMEGRILL_QA_HOME, or clone themegrill-qa beside this repo." >&2
  echo "            Commit refused rather than committing unscanned." >&2
  exit 1
fi

exec node "$QA_HOME/plugins/themegrill-qa/scripts/scan-secrets.mjs" \
  --staged --cwd "$(git rev-parse --show-toplevel)"
